.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# Datos de la usuaria: se versionan la biblioteca, sus archivos y las fuentes;
# respaldos, caché, registros, papelera y recopilaciones quedan solo en disco
data/respaldos/
data/cache/
data/logs/
data/papelera/
data/recopilaciones/
data/*.db-wal
data/*.db-shm
data/*.db-journal
data/.en_uso

# Herramientas de desarrollo (binario de Tailwind e íconos sueltos); solo se versionan los scripts
tools/tailwindcss*
tools/lucide-svg/

# Modelos de OCR (se descargan con `instalar`; viajan con la carpeta, no van en git)
modelos/

# Biblioteca de demostración (python -m app.demo); nunca se mezcla con los datos reales
demo/
